# Copy this file to .env.local and fill in what you need. .env.local is not committed.
# Restart `npm run dev` after changing it.

# Which network the dApp expects MetaMask to be on: sepolia (default) or anvil
VITE_CHAIN=sepolia

# Deployed DutchAuction address. Leave empty to use preview mode (simulated auction).
VITE_AUCTION_ADDRESS=

# Block the auction was deployed in (from Etherscan). Needed on Sepolia for the bid list; 0 is fine on Anvil.
VITE_AUCTION_DEPLOY_BLOCK=0

# Optional: your own Sepolia RPC URL if the public one is slow
# VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<your-key>
